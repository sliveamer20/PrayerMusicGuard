# =============================================================================
# PrayerMusicGuard (صلاة وسكون) — .gitignore
# Phase 20.48: hardened for GitHub. Rules below are the ONLY files excluded.
# Required source/build files (main.py, webview_app/, assets/, *.spec, *.iss,
# build_exe.bat, release.ps1, VERSION) are intentionally NOT ignored.
# =============================================================================

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]

# --- Build output (regenerated by build_exe.bat / release.ps1) ---
build/
dist/

# --- Local toolchains (machine-specific, huge, never committed) ---
# Win7 toolchain: Python 3.8.10 x64 (win7\python) + PyInstaller 5.13.2 (win7\venv)
win7/
# Modern dev toolchain (PyInstaller 6.x / cp314) — pinned separately
vendor/

# --- Local release archive (binaries stay local; structure + manifest tracked) ---
releases/*
!releases/.gitkeep
!releases/RELEASES.md

# --- Local backups and cleanup snapshots (internal history, not source) ---
backup/
cleanup_backup_phase20_*/

# --- Historical source snapshots and phase-20 test/QA scripts (local only;
# removed from the public repo in Phase 20.53; not required to build or run) ---
_backup_phase*.py
main_backup_*.py
main_before_*.py
qa_phase20_*.py
test_phase20_*.py
test_phase20_*.js
uat_phase20_*.py

# --- Local agent/AI tooling config (contains provider routing, not app source) ---
.opencode/
opencode.json

# --- Local-only internal development/QA history (removed from the public repo
# in Phase 20.53; reports/ is regenerated per phase and is not published) ---
reports/

# --- Local developer scratch scripts (read machine-local credential files) ---
diagnose.py
diagnose2.py
test_all.py
test_details.py
test_meta.py
test_nvidia.py
two_model_test.py

# --- Secrets, credentials, and signing private-key material (NEVER commit) ---
# PYZ encryption build secret (Phase 20.46.B): required to build, never bundled
# and never committed.
pyz_crypto_key.txt
# Authenticode signing private key, if ever exported from the certificate store.
*.pfx
*.pvk
*.p12
# Environment / local credential files
.env
.env.*
!.env.example
